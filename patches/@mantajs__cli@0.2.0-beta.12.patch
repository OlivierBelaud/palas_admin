+import { MantaError } from '@mantajs/core';
+/** HTTP and AI reads must push pagination into storage, never slice a full table. */
+export async function readServicePage(service, input) {
+    const limit = input.limit === undefined ? 100 : input.limit;
+    const offset = input.offset === undefined ? 0 : input.offset;
+    if (!Number.isSafeInteger(limit) || limit < 0 || limit > 10_000 || !Number.isSafeInteger(offset) || offset < 0) {
+        throw new MantaError('INVALID_DATA', 'limit must be an integer from 0 to 10000 and offset a non-negative integer');
+    }
+    if (input.q !== undefined && typeof input.q !== 'string') {
+        throw new MantaError('INVALID_DATA', 'Search must be a string');
+    }
+    if (typeof service.__queryPage !== 'function') {
+        throw new MantaError('INVALID_DATA', 'Entity does not provide bounded database reads');
+    }
+    const where = Object.create(null);
+    for (const [key, value] of Object.entries(input.filters ?? {})) {
+        // Empty IN must not be ignored by older repository adapters.
+        if (Array.isArray(value) && value.length === 0)
+            return { data: [], count: 0 };
+        where[key] = Array.isArray(value) ? { $in: value } : value;
+    }
+    let order;
+    if (input.order) {
+        const [field, direction] = input.order.startsWith('-') ? [input.order.slice(1), 'desc'] : input.order.split(':');
+        order = { [field]: direction === 'desc' ? 'DESC' : 'ASC' };
+    }
+    const [rows, count] = await service.__queryPage({
+        where,
+        fields: input.fields,
+        search: input.q,
+        limit,
+        offset,
+        order,
+        count: input.count,
+    });
+    const data = input.fields?.length && !input.fields.includes('*')
+        ? rows.map((row) => Object.fromEntries(input.fields.map((field) => [field, row[field]])))
+        : rows;
+    return { data, count };
+}
